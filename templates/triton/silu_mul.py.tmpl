"""[OmniKernel] $OP_NAME — Triton 后端（模板自动生成）
策略: $STRATEGY；融合 silu(a)*b 为单 kernel，省一次中间张量读写。
"""
import torch
import triton
import triton.language as tl


@triton.jit
def _silu_mul_fwd(A, B, Y, n, BLOCK: tl.constexpr):
    pid = tl.program_id(0)
    offs = pid * BLOCK + tl.arange(0, BLOCK)
    mask = offs < n
    a = tl.load(A + offs, mask=mask, other=0.0,
                eviction_policy="evict_first").to(tl.float32)
    b = tl.load(B + offs, mask=mask, other=0.0,
                eviction_policy="evict_first").to(tl.float32)
    y = a * tl.sigmoid(a) * b
    tl.store(Y + offs, y.to(Y.dtype.element_ty), mask=mask)


def run(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
    """out = silu(a) * b （SwiGLU 门控分支）"""
    assert a.shape == b.shape and a.is_contiguous() and b.is_contiguous()
    y = torch.empty_like(a)
    n = a.numel()
    grid = (triton.cdiv(n, $BLOCK_SIZE),)
    _silu_mul_fwd[grid](a, b, y, n, BLOCK=$BLOCK_SIZE, num_warps=$NUM_WARPS)
    return y
